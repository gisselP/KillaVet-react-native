        "foregroundImage": "./assets/killa3d.png",
        "backgroundColor": "#1D9E75"
      },
      "package": "com.killavet.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "8a6f0155-12ef-41cf-b8c6-866a4c50504b"
      }
    },
    "owner": "tuterrors-team"
  }
